---
import { contactChannels } from "../../data/site";

const ICONS: Record<string, string> = {
  github: `<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>`,
  linkedin: `<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>`,
  mail: `<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>`,
};

const email = contactChannels.find((c) => c.icon === "mail")!;
const linkedin = contactChannels.find((c) => c.icon === "linkedin")!;
const github = contactChannels.find((c) => c.icon === "github")!;
---

<section class="py-24 lg:py-32 relative">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-ember/[0.03] to-transparent"></div>

  <div class="relative z-10 max-w-xl mx-auto px-6 text-center" data-reveal>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-text-primary mb-4">
      Let's build something<span class="text-ember">.</span>
    </h2>
    <p class="text-base sm:text-lg text-text-secondary mb-10">
      Interested in working together or have a question? Feel free to reach out.
    </p>

    <div class="space-y-0 text-left" data-reveal-stagger data-reveal>
      {/* Row 1: Email — full width, primary */}
      <a
        href={email.url}
        class="group flex items-center gap-4 px-5 py-4 rounded-t-xl border border-border
               bg-bg-surface hover:border-ember/50 hover:bg-bg-elevated card-glow-warm
               transition-all duration-200"
      >
        <span
          class="w-11 h-11 rounded-lg flex items-center justify-center shrink-0
                 border border-ember/30 bg-ember/10 text-ember
                 transition-colors duration-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS.mail} />
        </span>
        <div class="min-w-0 flex-grow">
          <div class="text-[0.65rem] sm:text-xs font-mono text-text-muted uppercase tracking-[0.2em]">
            Email
          </div>
          <div class="text-sm sm:text-base text-text-primary font-mono truncate group-hover:text-ember transition-colors duration-200">
            {email.value}
          </div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-muted shrink-0 group-hover:text-ember group-hover:translate-x-0.5 transition-all duration-200">
          <path d="M7 7h10v10"/>
          <path d="M7 17 17 7"/>
        </svg>
      </a>

      {/* Row 2: LinkedIn + GitHub — 2 columns */}
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-0">
        <a
          href={linkedin.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-3 px-5 py-4 sm:rounded-bl-xl border border-border
                 bg-bg-surface hover:border-ember/50 hover:bg-bg-elevated card-glow-warm
                 transition-all duration-200 min-w-0"
        >
          <span
            class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0
                   border border-border bg-bg-deep text-text-secondary
                   group-hover:border-ember/40 group-hover:text-ember
                   transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS.linkedin} />
          </span>
          <div class="min-w-0 flex-grow">
            <div class="text-[0.65rem] font-mono text-text-muted uppercase tracking-[0.2em]">
              LinkedIn
            </div>
            <div class="text-xs sm:text-sm text-text-primary font-mono truncate group-hover:text-ember transition-colors duration-200">
              {linkedin.value}
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-muted shrink-0 group-hover:text-ember group-hover:translate-x-0.5 transition-all duration-200">
            <path d="M7 7h10v10"/>
            <path d="M7 17 17 7"/>
          </svg>
        </a>

        <a
          href={github.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-3 px-5 py-4 rounded-b-xl sm:rounded-bl-none border border-border
                 bg-bg-surface hover:border-ember/50 hover:bg-bg-elevated card-glow-warm
                 transition-all duration-200 min-w-0"
        >
          <span
            class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0
                   border border-border bg-bg-deep text-text-secondary
                   group-hover:border-ember/40 group-hover:text-ember
                   transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS.github} />
          </span>
          <div class="min-w-0 flex-grow">
            <div class="text-[0.65rem] font-mono text-text-muted uppercase tracking-[0.2em]">
              GitHub
            </div>
            <div class="text-xs sm:text-sm text-text-primary font-mono truncate group-hover:text-ember transition-colors duration-200">
              {github.value}
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-muted shrink-0 group-hover:text-ember group-hover:translate-x-0.5 transition-all duration-200">
            <path d="M7 7h10v10"/>
            <path d="M7 17 17 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
