---
import { experiences } from "../../data/site";
import ExperienceCard from "../ExperienceCard.astro";
---

<section
  id="experience"
  class="relative max-w-6xl mx-auto px-6 py-24 lg:py-32"
>
  <h2
    class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-text-primary mb-12 sm:mb-16 text-center"
    data-reveal
  >
    Experience<span class="text-ember">.</span>
  </h2>

  {/* Mobile: stacked cards */}
  <div class="md:hidden space-y-10" data-reveal-stagger>
    {experiences.map((exp) => (
      <div
        class="p-5 rounded-2xl border border-border bg-bg-surface card-glow-warm"
      >
        <ExperienceCard experience={exp} />
      </div>
    ))}
  </div>

  {/* Desktop: scroll-driven sticky tabs */}
  <div
    class="hidden md:grid md:grid-cols-[15rem_1fr] lg:grid-cols-[17rem_1fr] gap-12 lg:gap-16"
    data-experience-root
  >
    {/* Left rail */}
    <nav
      class="sticky self-start top-24"
      aria-label="Experience tabs"
      data-experience-tabs
    >
      <ul class="space-y-1 border-l border-border" role="tablist">
        {experiences.map((exp, i) => (
          <li>
            <button
              type="button"
              class:list={[
                "experience-tab w-full text-left px-5 py-3 -ml-px border-l-2 border-transparent transition-all duration-200",
                i === 0 && "is-active",
              ]}
              data-tab-index={i}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
            >
              <div class="experience-tab-company text-sm font-display font-semibold tracking-wide">
                {exp.company}
              </div>
              <div class="text-[0.7rem] mt-1 font-mono opacity-80">
                {exp.startDate} &mdash; {exp.endDate ?? "Present"}
              </div>
            </button>
          </li>
        ))}
      </ul>
    </nav>

    {/* Right pane */}
    <div class="space-y-32 lg:space-y-40" data-experience-pane>
      {experiences.map((exp, i) => (
        <article
          class:list={[
            "experience-role scroll-mt-24",
            i !== 0 && "is-dimmed",
          ]}
          data-role-anchor={i}
        >
          <ExperienceCard experience={exp} />
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const root = document.querySelector("[data-experience-root]");
  if (root) {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-tab-index]"),
    );
    const roles = Array.from(
      root.querySelectorAll<HTMLElement>("[data-role-anchor]"),
    );

    const setActive = (idx: number) => {
      tabs.forEach((t) => {
        const isActive = Number(t.dataset.tabIndex) === idx;
        t.classList.toggle("is-active", isActive);
        t.setAttribute("aria-selected", isActive ? "true" : "false");
      });
      roles.forEach((r) => {
        const isActive = Number(r.dataset.roleAnchor) === idx;
        r.classList.toggle("is-dimmed", !isActive);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        // Pick the entry whose anchor is closest to the trigger line.
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort(
            (a, b) =>
              Math.abs(a.boundingClientRect.top) -
              Math.abs(b.boundingClientRect.top),
          );
        if (visible[0]) {
          setActive(Number((visible[0].target as HTMLElement).dataset.roleAnchor));
        }
      },
      {
        // Only the middle ~10% strip of the viewport counts as "active".
        rootMargin: "-40% 0px -50% 0px",
        threshold: 0,
      },
    );
    roles.forEach((r) => observer.observe(r));

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const idx = Number(tab.dataset.tabIndex);
        const target = roles[idx];
        if (!target) return;
        target.scrollIntoView({
          behavior: reduceMotion ? "auto" : "smooth",
          block: "start",
        });
        setActive(idx);
      });
    });
  }
</script>
