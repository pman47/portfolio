---
import { experiences } from "../../data/site";
import ExperienceCard from "../ExperienceCard.astro";
---

<section class="py-24 lg:py-32 max-w-5xl mx-auto px-6">
  <h2
    class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-text-primary mb-10 sm:mb-16 text-center"
    data-reveal
  >
    Experience<span class="text-ember">.</span>
  </h2>

  <div class="relative">
    <!-- Vertical Timeline Line -->
    <div class="absolute left-4 lg:left-1/2 lg:-translate-x-px top-0 bottom-0 w-px bg-border"></div>

    {experiences.map((exp, i) => (
      <div
        class:list={[
          "relative flex mb-8 sm:mb-12 last:mb-0",
          i % 2 === 0 ? "lg:flex-row" : "lg:flex-row-reverse",
        ]}
        data-reveal={i % 2 === 0 ? "left" : "right"}
      >
        <!-- Timeline Dot -->
        <div
          class:list={[
            "absolute left-4 lg:left-1/2 w-3 h-3 rounded-full bg-ember -translate-x-1/2 mt-2 z-10",
            exp.endDate === null && "pulse-ember",
          ]}
        />

        <!-- Spacer for mobile (dot space) -->
        <div class="lg:hidden w-12 shrink-0" />

        <!-- Card -->
        <div
          class:list={[
            "lg:w-[calc(50%-2rem)] p-4 sm:p-6 rounded-2xl border border-border bg-bg-surface",
            "card-glow-warm hover:border-border-hover transition-all duration-300",
            i % 2 === 0 ? "lg:mr-auto" : "lg:ml-auto",
          ]}
        >
          <ExperienceCard experience={exp} />
        </div>
      </div>
    ))}
  </div>
</section>
