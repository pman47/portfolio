---
import { aboutContent } from "../../data/site";
import { splitIntoSegments } from "../../lib/metric-chips";

const summarySegments = splitIntoSegments(aboutContent.summary);
---

<section class="py-24 lg:py-32 max-w-5xl mx-auto px-6">
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16 items-start">
    <!-- Left: Heading + Summary -->
    <div class="lg:col-span-3" data-reveal="left">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-text-primary mb-2">
        About<span class="text-ember">.</span>
      </h2>
      <p class="text-lg text-text-secondary leading-relaxed mt-6">
        {summarySegments.map((seg) =>
          seg.isChip ? <span class="metric-chip">{seg.text}</span> : seg.text,
        )}
      </p>
    </div>

    <!-- Right: Stat strip -->
    <div class="lg:col-span-2 grid grid-cols-2 gap-3" data-reveal-stagger data-reveal="right">
      {aboutContent.stats.map((stat) => (
        <div
          class="p-4 sm:p-5 rounded-xl border border-border bg-bg-surface
                 hover:border-ember/40 transition-colors duration-300 card-glow-warm"
        >
          <div class="text-2xl sm:text-3xl font-display font-bold text-ember leading-tight">
            {stat.value}
          </div>
          <div class="text-[0.7rem] sm:text-xs font-mono text-text-muted uppercase tracking-wider mt-2">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
