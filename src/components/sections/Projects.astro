---
import { projects } from "../../data/site";
import ProjectCard from "../ProjectCard.astro";
---

<section class="py-24 lg:py-32 max-w-5xl mx-auto px-6">
  <h2
    class="text-4xl sm:text-5xl font-display font-bold text-text-primary mb-12"
    data-reveal
  >
    Projects<span class="text-ember">.</span>
  </h2>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" data-reveal-stagger data-reveal>
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </div>
</section>
