---
import { education } from "../../data/site";
---

<section class="py-16 max-w-5xl mx-auto px-6" data-reveal>
  <div
    class="flex flex-col sm:flex-row sm:items-center gap-6 p-6 rounded-2xl
           border border-border bg-bg-surface card-glow-warm"
  >
    <div
      class="w-12 h-12 rounded-xl bg-ember/10 flex items-center justify-center shrink-0"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-ember"
      >
        <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
        <path d="M6 12v5c3 3 6 3 6 3s3 0 6-3v-5"></path>
      </svg>
    </div>
    <div>
      <h3 class="text-lg font-display font-bold text-text-primary">
        {education.degree}
      </h3>
      <p class="text-sm text-text-secondary mt-1">
        {education.institution}, {education.location}
      </p>
      <p class="text-xs font-mono text-text-muted mt-1">
        {education.startYear} &mdash; {education.endYear}
      </p>
    </div>
  </div>
</section>
