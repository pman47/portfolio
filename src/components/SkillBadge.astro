---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<span
  class="inline-block px-2.5 py-1 text-xs sm:px-4 sm:py-2 sm:text-sm font-mono rounded-xl
         border border-border bg-bg-surface text-text-secondary
         skill-badge-interactive cursor-default select-none"
>
  {name}
</span>
