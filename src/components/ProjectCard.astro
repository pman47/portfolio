---
import type { ProjectItem } from "../data/site";
import SkillBadge from "./SkillBadge.astro";

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
---

<div
  data-tilt
  class="p-8 rounded-2xl border border-border bg-bg-surface
         card-glow-warm hover:border-border-hover
         transition-shadow duration-300 will-change-transform"
>
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-2xl font-display font-bold text-text-primary">
      {project.title}
    </h3>
    <div class="flex gap-3">
      {project.liveUrl && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-spark hover:text-ember transition-colors link-underline"
          aria-label={`Visit ${project.title} live`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h6v6" />
            <path d="M10 14 21 3" />
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          </svg>
        </a>
      )}
      {project.githubUrl && (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-secondary hover:text-ember transition-colors link-underline"
          aria-label={`View ${project.title} on GitHub`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
        </a>
      )}
    </div>
  </div>

  <p class="text-text-secondary leading-relaxed mb-6">
    {project.description}
  </p>

  <div class="flex flex-wrap gap-2">
    {project.techStack.map((tech) => (
      <SkillBadge name={tech} />
    ))}
  </div>
</div>
