---
import type { ProjectItem } from "../data/site";
import { splitIntoSegments } from "../lib/metric-chips";
import SkillBadge from "./SkillBadge.astro";

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const descSegments = splitIntoSegments(project.description);
const outcomeSegments = splitIntoSegments(project.outcome);
---

<div
  data-tilt
  class="group relative p-6 sm:p-8 rounded-2xl border border-border bg-bg-surface
         card-glow-warm hover:border-ember/40
         transition-shadow duration-300 will-change-transform h-full flex flex-col"
>
  <div class="flex items-start justify-between gap-4 mb-5">
    <div class="flex items-center gap-4">
      <div
        class="w-14 h-14 rounded-xl flex items-center justify-center shrink-0
               border border-ember/30 bg-gradient-to-br from-ember/15 to-forge-red/10
               text-ember font-display font-bold text-lg tracking-wider
               group-hover:scale-105 transition-transform duration-300"
        aria-hidden="true"
      >
        {project.monogram}
      </div>
      <h3 class="text-xl sm:text-2xl font-display font-bold text-text-primary leading-tight">
        {project.title}
      </h3>
    </div>
    <div class="flex gap-2 shrink-0">
      {project.liveUrl && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-secondary hover:text-ember transition-colors p-2 -m-2"
          aria-label={`Visit ${project.title} live`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h6v6" />
            <path d="M10 14 21 3" />
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          </svg>
        </a>
      )}
      {project.githubUrl && (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-secondary hover:text-ember transition-colors p-2 -m-2"
          aria-label={`View ${project.title} on GitHub`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
        </a>
      )}
    </div>
  </div>

  <p class="text-base sm:text-lg font-display font-semibold text-spark mb-3 leading-snug">
    {outcomeSegments.map((seg) =>
      seg.isChip ? <span class="metric-chip">{seg.text}</span> : seg.text,
    )}
  </p>

  <p class="text-sm sm:text-[0.95rem] text-text-secondary leading-relaxed mb-6 flex-grow">
    {descSegments.map((seg) =>
      seg.isChip ? <span class="metric-chip">{seg.text}</span> : seg.text,
    )}
  </p>

  <div class="flex flex-wrap gap-2">
    {project.techStack.map((tech) => (
      <SkillBadge name={tech} />
    ))}
  </div>
</div>
